<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.HomeCustomerPage"
    x:Name="HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:m="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="#FAF7F5"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable dashboard -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,20" Spacing="18">

                <!-- Location + notification -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label
                            Text="Location"
                            FontSize="12"
                            TextColor="#757575" />
                        <HorizontalStackLayout Spacing="5">
                            <Image
                                WidthRequest="17"
                                HeightRequest="17"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Location_on}"
                                        Color="#D9534F"
                                        Size="17" />
                                </Image.Source>
                            </Image>
                            <Label
                                Text="Pasar Kemis, Tangerang"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#1E1E1E"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <uranium:ButtonView
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="#FFFFFF"
                        Stroke="#EFE6E4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Notifikasi"
                        TappedCommand="{Binding OpenNotificationsCommand}">
                        <Grid InputTransparent="True">
                            <Image
                                WidthRequest="22"
                                HeightRequest="22"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Notifications}"
                                        Color="#1E1E1E"
                                        Size="22" />
                                </Image.Source>
                            </Image>
                            <Border
                                WidthRequest="8"
                                HeightRequest="8"
                                BackgroundColor="#D9534F"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,9,9,0" />
                        </Grid>
                    </uranium:ButtonView>
                </Grid>

                <!-- Search + filter -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <material:TextField
                        Title="Cari layanan, paket, atau gaya..."
                        Text="{Binding SearchText}"
                        AccentColor="#D9534F"
                        BorderColor="#EFE6E4"
                        CornerRadius="12"
                        BackgroundColor="#FFFFFF"
                        FontSize="13"
                        TitleFontSize="12"
                        HeightRequest="50">
                        <material:TextField.Icon>
                            <FontImageSource
                                FontFamily="MaterialOutlined"
                                Glyph="{x:Static m:MaterialRegular.Search}"
                                Color="#757575"
                                Size="21" />
                        </material:TextField.Icon>
                    </material:TextField>

                    <uranium:ButtonView
                        Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#D9534F"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="0"
                        VerticalOptions="End"
                        SemanticProperties.Description="Filter layanan"
                        TappedCommand="{Binding FilterCommand}">
                        <Image
                            WidthRequest="23"
                            HeightRequest="23"
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Tune}"
                                    Color="#FFFFFF"
                                    Size="23" />
                            </Image.Source>
                        </Image>
                    </uranium:ButtonView>
                </Grid>

                <!-- Hero banners -->
                <VerticalStackLayout Spacing="4">
                    <CarouselView
                        ItemsSource="{Binding Banners}"
                        HeightRequest="160"
                        IndicatorView="{x:Reference bannerIndicator}"
                        Loop="False"
                        PeekAreaInsets="0"
                        IsBounceEnabled="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    HeightRequest="160"
                                    BackgroundColor="#FDECEC"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                    <Grid IsClippedToBounds="True">
                                        <Image
                                            HeightRequest="160"
                                            Source="{Binding ImageSource}"
                                            Aspect="AspectFit"
                                            IsVisible="{Binding HasImage}" />

                                        <VerticalStackLayout
                                            IsVisible="{Binding ShowFallback}"
                                            Padding="20"
                                            Spacing="6"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Badge}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="#D9534F" />
                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="21"
                                                FontAttributes="Bold"
                                                TextColor="#8B2626" />
                                            <Label
                                                Text="{Binding Subtitle}"
                                                FontSize="12"
                                                TextColor="#757575" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView
                        x:Name="bannerIndicator"
                        IndicatorColor="#E0CFCB"
                        SelectedIndicatorColor="#D9534F"
                        IndicatorSize="8"
                        HorizontalOptions="Center"
                        Margin="0,6,0,0" />
                </VerticalStackLayout>

                <!-- Categories -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Layanan"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1E1E1E"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Lihat Semua"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D9534F"
                            VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeeAllServicesCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding Categories}"
                        HeightRequest="96"
                        SelectionMode="None"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <uranium:ButtonView
                                    WidthRequest="60"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    Padding="0"
                                    TappedCommand="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference HomePage}}"
                                    CommandParameter="{Binding .}">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" InputTransparent="True">
                                        <Border
                                            WidthRequest="58"
                                            HeightRequest="58"
                                            BackgroundColor="#FDECEC"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 29">
                                            <Image
                                                WidthRequest="25"
                                                HeightRequest="25"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="MaterialOutlined"
                                                        Glyph="{Binding IconGlyph}"
                                                        Color="#D9534F"
                                                        Size="25" />
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="11"
                                            TextColor="#1E1E1E"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="WordWrap"
                                            MaxLines="2"
                                            HeightRequest="30" />
                                    </VerticalStackLayout>
                                </uranium:ButtonView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Favorite services -->
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Layanan Favorit"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#1E1E1E" />

                    <CollectionView
                        ItemsSource="{Binding FavoriteServices}"
                        HeightRequest="700"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <uranium:ButtonView
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#EFE6E4"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10"
                                    SemanticProperties.Description="{Binding Name}"
                                    TappedCommand="{Binding BindingContext.SelectServiceCommand, Source={x:Reference HomePage}}"
                                    CommandParameter="{Binding .}">
                                    <VerticalStackLayout Spacing="8" InputTransparent="True">

                                        <Border
                                            HeightRequest="115"
                                            BackgroundColor="#FDECEC"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12">
                                            <Grid>
                                                <Border
                                                    WidthRequest="94"
                                                    HeightRequest="94"
                                                    BackgroundColor="#F8DCDC"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 47"
                                                    Opacity="0.75"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                                <Image
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="MaterialOutlined"
                                                            Glyph="{Binding IconGlyph}"
                                                            Color="#D9534F"
                                                            Size="44" />
                                                    </Image.Source>
                                                </Image>

                                                <Border
                                                    WidthRequest="28"
                                                    HeightRequest="28"
                                                    BackgroundColor="#FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="0,8,8,0">
                                                    <Image
                                                        WidthRequest="15"
                                                        HeightRequest="15"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="MaterialOutlined"
                                                                Glyph="{x:Static m:MaterialRegular.Favorite}"
                                                                Color="#D9534F"
                                                                Size="15" />
                                                        </Image.Source>
                                                    </Image>
                                                </Border>

                                                <Border
                                                    BackgroundColor="#FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="7,3"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="End"
                                                    Margin="0,0,8,8">
                                                    <HorizontalStackLayout Spacing="2">
                                                        <Label
                                                            Text="★"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="#F59E0B"
                                                            VerticalTextAlignment="Center" />
                                                        <Label
                                                            Text="{Binding RatingText}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="#1E1E1E"
                                                            VerticalTextAlignment="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#1E1E1E"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1" />

                                        <HorizontalStackLayout Spacing="4">
                                            <Label
                                                Text="{Binding FormattedPrice}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="#D9534F" />
                                            <Label
                                                Text="|"
                                                FontSize="12"
                                                TextColor="#D7C9C5" />
                                            <Label
                                                Text="{Binding Duration}"
                                                FontSize="12"
                                                TextColor="#757575" />
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>
                                </uranium:ButtonView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Grid
            Grid.Row="1"
            HeightRequest="65"
            BackgroundColor="#FFFFFF"
            RowDefinitions="1,*">
            <BoxView
                HeightRequest="1"
                BackgroundColor="#EFE6E4"
                VerticalOptions="Start" />
            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*,*,*,*">

                <uranium:ButtonView
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    SemanticProperties.Description="Home">
                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        InputTransparent="True">
                        <Image WidthRequest="22" HeightRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Home}"
                                    Color="#D9534F"
                                    Size="22" />
                            </Image.Source>
                        </Image>
                        <Label
                            Text="Home"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#D9534F"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </uranium:ButtonView>

                <uranium:ButtonView
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    SemanticProperties.Description="Explore"
                    TappedCommand="{Binding NavigateTabCommand}"
                    CommandParameter="Explore">
                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        InputTransparent="True">
                        <Image WidthRequest="22" HeightRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Explore}"
                                    Color="#757575"
                                    Size="22" />
                            </Image.Source>
                        </Image>
                        <Label
                            Text="Explore"
                            FontSize="11"
                            TextColor="#757575"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </uranium:ButtonView>

                <uranium:ButtonView
                    Grid.Column="2"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    SemanticProperties.Description="Booking"
                    TappedCommand="{Binding NavigateTabCommand}"
                    CommandParameter="Booking">
                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        InputTransparent="True">
                        <Image WidthRequest="22" HeightRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Calendar_month}"
                                    Color="#757575"
                                    Size="22" />
                            </Image.Source>
                        </Image>
                        <Label
                            Text="Booking"
                            FontSize="11"
                            TextColor="#757575"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </uranium:ButtonView>

                <uranium:ButtonView
                    Grid.Column="3"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    SemanticProperties.Description="Chat"
                    TappedCommand="{Binding NavigateTabCommand}"
                    CommandParameter="Chat">
                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        InputTransparent="True">
                        <Image WidthRequest="22" HeightRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Chat_bubble_outline}"
                                    Color="#757575"
                                    Size="22" />
                            </Image.Source>
                        </Image>
                        <Label
                            Text="Chat"
                            FontSize="11"
                            TextColor="#757575"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </uranium:ButtonView>

                <uranium:ButtonView
                    Grid.Column="4"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    SemanticProperties.Description="Profil"
                    TappedCommand="{Binding NavigateTabCommand}"
                    CommandParameter="Profil">
                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        InputTransparent="True">
                        <Image WidthRequest="22" HeightRequest="22">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static m:MaterialRegular.Person_outline}"
                                    Color="#757575"
                                    Size="22" />
                            </Image.Source>
                        </Image>
                        <Label
                            Text="Profil"
                            FontSize="11"
                            TextColor="#757575"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </uranium:ButtonView>

            </Grid>
        </Grid>
    </Grid>

    <!-- Service quick preview bottom sheet -->
    <uranium:UraniumContentPage.Attachments>
            <material:BottomSheetView
                IsPresented="{Binding IsServiceDetailOpen, Mode=TwoWay}">
                <!-- The default generated header is a drag handle that stays visible
                     over the bottom navigation even while the sheet is closed. -->
                <material:BottomSheetView.Header>
                    <BoxView HeightRequest="0" Color="Transparent" />
                </material:BottomSheetView.Header>
                <material:BottomSheetView.Triggers>
                    <DataTrigger
                        TargetType="material:BottomSheetView"
                        Binding="{Binding IsServiceDetailOpen}"
                        Value="False">
                        <Setter Property="InputTransparent" Value="True" />
                    </DataTrigger>
                </material:BottomSheetView.Triggers>
                <VerticalStackLayout Padding="20,8,20,28" Spacing="16">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border
                            WidthRequest="52"
                            HeightRequest="52"
                            BackgroundColor="#FDECEC"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26">
                            <Image
                                WidthRequest="26"
                                HeightRequest="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{Binding SelectedService.IconGlyph}"
                                        Color="#D9534F"
                                        Size="26" />
                                </Image.Source>
                            </Image>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                Text="{Binding SelectedService.Name}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#1E1E1E" />
                            <Label
                                Text="{Binding SelectedService.FormattedPrice}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#D9534F" />
                        </VerticalStackLayout>

                        <uranium:ButtonView
                            Grid.Column="2"
                            WidthRequest="36"
                            HeightRequest="36"
                            BackgroundColor="#FAF7F5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Tutup detail layanan"
                            TappedCommand="{Binding CloseServiceDetailCommand}">
                            <Image
                                WidthRequest="19"
                                HeightRequest="19"
                                InputTransparent="True"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static m:MaterialRegular.Close}"
                                        Color="#1E1E1E"
                                        Size="19" />
                                </Image.Source>
                            </Image>
                        </uranium:ButtonView>
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Border
                            BackgroundColor="#FAF7F5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,5">
                            <HorizontalStackLayout Spacing="4">
                                <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static m:MaterialRegular.Star}"
                                            Color="#F59E0B"
                                            Size="14" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Text="{Binding SelectedService.RatingText}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#1E1E1E"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border
                            BackgroundColor="#FAF7F5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,5">
                            <HorizontalStackLayout Spacing="4">
                                <Image WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="MaterialOutlined"
                                            Glyph="{x:Static m:MaterialRegular.Calendar_month}"
                                            Color="#757575"
                                            Size="14" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Text="{Binding SelectedService.Duration}"
                                    FontSize="12"
                                    TextColor="#757575"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <Label
                        Text="{Binding SelectedService.Description}"
                        FontSize="13"
                        TextColor="#757575"
                        LineBreakMode="WordWrap" />

                    <Button
                        Text="Booking Sekarang"
                        Command="{Binding BookServiceCommand}"
                        BackgroundColor="#D9534F"
                        TextColor="#FFFFFF"
                        CornerRadius="24"
                        HeightRequest="52"
                        FontAttributes="Bold"
                        FontSize="15"
                        Margin="0,4,0,0" />

                </VerticalStackLayout>
            </material:BottomSheetView>
    </uranium:UraniumContentPage.Attachments>

</uranium:UraniumContentPage>
