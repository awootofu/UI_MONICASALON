<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="UAS_APP_MONICASALON.Views.Admin.AdminBookingsPage"
    x:Name="BookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:admin="clr-namespace:UAS_APP_MONICASALON.Controls.Admin"
    xmlns:icons="clr-namespace:UAS_APP_MONICASALON.Icons"
    BackgroundColor="{StaticResource Background}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <admin:AdminLayout
        PageTitle="Booking"
        ActiveRoute="AdminBookingsPage">

        <admin:AdminLayout.PageContent>
            <Grid
                Padding="20,6,20,20"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="12">

                <!-- Search and filters -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Style="{StaticResource AdminInputShell}">
                            <material:TextField
                                Title="Cari nama, layanan, atau ID..."
                                Text="{Binding SearchText}"
                                Style="{StaticResource AdminTextField}"
                                SemanticProperties.Description="Cari booking">
                                <material:TextField.Icon>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Search}"
                                        Color="{StaticResource TextSecondary}"
                                        Size="20" />
                                </material:TextField.Icon>
                            </material:TextField>
                        </Border>

                        <uranium:ButtonView
                            Grid.Column="1"
                            Style="{StaticResource AdminIconButton}"
                            WidthRequest="50"
                            HeightRequest="50"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Booking Baru"
                            TappedCommand="{Binding NewBookingCommand}">
                            <Image
                                WidthRequest="22"
                                HeightRequest="22"
                                InputTransparent="True"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.Add}"
                                        Color="{StaticResource OnPrimary}"
                                        Size="22" />
                                </Image.Source>
                            </Image>
                        </uranium:ButtonView>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Tanggal"
                                Style="{StaticResource AdminFilterLabel}" />
                            <Border Style="{StaticResource AdminInputShell}">
                                <material:PickerField
                                    Title=""
                                    ItemsSource="{Binding DateFilters}"
                                    SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay}"
                                    Style="{StaticResource AdminPickerField}"
                                    SemanticProperties.Description="Filter tanggal booking" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label
                                Text="Status"
                                Style="{StaticResource AdminFilterLabel}" />
                            <Border Style="{StaticResource AdminInputShell}">
                                <material:PickerField
                                    Title=""
                                    ItemsSource="{Binding StatusFilters}"
                                    SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                    Style="{StaticResource AdminPickerField}"
                                    SemanticProperties.Description="Filter status booking" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Result summary -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <Label
                        Text="{Binding ResultsText}"
                        Style="{StaticResource AdminCaption}"
                        VerticalTextAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Text="Reset Filter"
                        Style="{StaticResource AdminLinkButton}"
                        Command="{Binding ClearFiltersCommand}"
                        IsVisible="{Binding HasActiveFilters}" />
                </Grid>

                <!-- Booking cards -->
                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding FilteredBookings}"
                    SelectionMode="None"
                    ItemSizingStrategy="MeasureAllItems"
                    VerticalScrollBarVisibility="Default">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource AdminCard}"
                                Padding="14"
                                Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="{StaticResource Secondary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding CustomerInitials}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{Binding CustomerName}"
                                                Style="{StaticResource AdminCellTitle}"
                                                FontSize="13" />
                                            <Label
                                                Text="{Binding CustomerMeta}"
                                                Style="{StaticResource AdminCellMeta}" />
                                        </VerticalStackLayout>

                                        <admin:StatusBadge
                                            Grid.Column="2"
                                            Text="{Binding StatusText}"
                                            Status="{Binding Status}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Outline}" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="12"
                                        RowSpacing="8">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Layanan" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding ServiceName}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="Staf" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding StaffName}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Spacing="1">
                                            <Label Text="Jadwal" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding ScheduleText}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="1">
                                            <Label Text="Harga" Style="{StaticResource AdminCaption}" />
                                            <Label
                                                Text="{Binding PriceText}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Button
                                        Text="Lihat Detail"
                                        Style="{StaticResource AdminSoftButton}"
                                        Command="{Binding BindingContext.ShowDetailCommand, Source={x:Reference BookingsPage}}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="Fill" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Padding="24"
                            Spacing="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image
                                WidthRequest="36"
                                HeightRequest="36"
                                HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="MaterialOutlined"
                                        Glyph="{x:Static icons:AdminIcons.EmptyBookings}"
                                        Color="{StaticResource TextSecondary}"
                                        Size="36" />
                                </Image.Source>
                            </Image>
                            <Label
                                Text="Tidak ada booking"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Coba ubah kata kunci atau filter tanggal dan status."
                                Style="{StaticResource AdminCaption}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </admin:AdminLayout.PageContent>
    </admin:AdminLayout>

    <!-- Booking detail sheet -->
    <uranium:UraniumContentPage.Attachments>
        <material:BottomSheetView IsPresented="{Binding IsDetailOpen, Mode=TwoWay}">
            <material:BottomSheetView.Header>
                <BoxView HeightRequest="0" Color="Transparent" />
            </material:BottomSheetView.Header>
            <material:BottomSheetView.Triggers>
                <DataTrigger
                    TargetType="material:BottomSheetView"
                    Binding="{Binding IsDetailOpen}"
                    Value="False">
                    <Setter Property="InputTransparent" Value="True" />
                </DataTrigger>
            </material:BottomSheetView.Triggers>

            <VerticalStackLayout Padding="20,8,20,24" Spacing="16">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        WidthRequest="50"
                        HeightRequest="50"
                        BackgroundColor="{StaticResource Secondary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 25"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding SelectedBooking.CustomerInitials}"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="{Binding SelectedBooking.CustomerName}"
                            FontFamily="OpenSansSemibold"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            Text="{Binding SelectedBooking.CustomerPhone}"
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <uranium:ButtonView
                        Grid.Column="2"
                        Style="{StaticResource AdminIconButton}"
                        BackgroundColor="{StaticResource Background}"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Tutup detail booking"
                        TappedCommand="{Binding CloseDetailCommand}">
                        <Image
                            WidthRequest="19"
                            HeightRequest="19"
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="MaterialOutlined"
                                    Glyph="{x:Static icons:AdminIcons.Close}"
                                    Color="{StaticResource TextPrimary}"
                                    Size="19" />
                            </Image.Source>
                        </Image>
                    </uranium:ButtonView>
                </Grid>

                <Label
                    Text="{Binding SelectedBooking.CustomerMeta}"
                    Style="{StaticResource AdminCaption}" />

                <Border
                    BackgroundColor="{StaticResource Background}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                            <Label Text="Layanan" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SelectedBooking.ServiceName}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                            <Label Text="Staf" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SelectedBooking.StaffName}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                            <Label Text="Jadwal" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SelectedBooking.ScheduleText}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                            <Label Text="Status" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                            <admin:StatusBadge
                                Grid.Column="1"
                                Text="{Binding SelectedBooking.StatusText}"
                                Status="{Binding SelectedBooking.Status}" />
                        </Grid>

                        <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                            <Label Text="Harga" Style="{StaticResource AdminCaption}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SelectedBooking.PriceText}"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="Hubungi Pelanggan"
                    Style="{StaticResource AdminPrimaryButton}"
                    Command="{Binding ContactCustomerCommand}"
                    HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </material:BottomSheetView>
    </uranium:UraniumContentPage.Attachments>

</uranium:UraniumContentPage>
